<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/chat_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/webview_login"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnLoginCopy"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="copy"
            android:src="@android:drawable/ic_menu_save"
            android:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnLoginExternal"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="browser"
            android:src="@drawable/ic_history"
            android:tint="@color/text_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/loginProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="4dp"
        android:text="@string/loading_models"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <WebView
        android:id="@+id/loginWeb"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Вошёл через Google? Нажми ✓ — приложение само завершит подключение"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:paddingBottom="6dp" />

        <Button
            android:id="@+id/btnLoginDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✓ Готово — вернуться" />
    </LinearLayout>
</LinearLayout>
